# Copy to .env for local development. Never commit .env (see .gitignore).
MPHONE_GATEWAY_URL=http://localhost:8080
MPHONE_DATABASE_URL=postgresql+asyncpg://mphone:mphone@localhost:5432/mphone
MPHONE_REDIS_URL=redis://localhost:6379/0
MPHONE_S3_ENDPOINT=http://localhost:9000
MPHONE_S3_BUCKET=mphone-artifacts
# MPHONE_API_KEY=   # set via `mphone login`, stored in the OS keychain, not here
